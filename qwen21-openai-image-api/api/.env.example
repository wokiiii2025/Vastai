# Key issued by this API to its clients. Set a strong random value before starting.
OPENAI_API_KEY=
BIND_ADDRESS=127.0.0.1
API_PORT=8080

# Single backend without authentication
COMFY_URL=http://host.docker.internal:8188

# Replace COMFY_URL with COMFY_BACKENDS for one or several authenticated/mixed backends.
# COMFY_BACKENDS='[{"name":"worker1","url":"http://host.docker.internal:8188"},{"name":"worker2","url":"https://comfy.example.org","auth":{"type":"bearer","token_env":"COMFY_2_TOKEN"}}]'
# COMFY_2_TOKEN=

# IMAGE_TIMEOUT=1800
# IMAGE_MAX_DIMENSION=4096
# PUBLIC_BASE_URL=https://images.example.org
